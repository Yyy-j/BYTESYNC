/* pages/summary/summary.wxss */

.container {
  padding: var(--spacing-xl) var(--page-padding);
  padding-bottom: calc(var(--spacing-xxl) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--spacing-xxl) + env(safe-area-inset-bottom));
  min-height: 100vh;
  background: var(--color-bg);
}

.header {
  margin-bottom: var(--spacing-xl);
}

.title {
  display: block;
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.2;
  margin-bottom: var(--spacing-md);
}

.cards-section {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
}
