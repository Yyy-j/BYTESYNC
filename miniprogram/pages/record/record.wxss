/* pages/record/record.wxss */

.page {
  min-height: 100vh;
  background: var(--color-bg);
}

/* ══════════════════════════════════════
   IDLE 状态
══════════════════════════════════════ */

.idle-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: var(--spacing-xl) var(--page-padding) 0;
  padding-bottom: calc(var(--spacing-xxl) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--spacing-xxl) + env(safe-area-inset-bottom));
}

.idle-header {
  padding-top: var(--spacing-xl);
}

.page-title {
  display: block;
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.2;
}

.page-subtitle {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  margin-top: var(--spacing-sm);
}

.idle-camera {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xl);
  padding: var(--spacing-xl) 0;
  min-height: 70vh;
}

/* ── 辅助提示输入框行 ── */
.hint-row {
  width: 100%;
  max-width: 560rpx;
  display: flex;
  align-items: flex-end;
  gap: var(--spacing-sm);
}

.hint-input {
  flex: 1;
  min-width: 0;
  min-height: 96rpx;      /* 至少两行 */
  background: rgba(111, 207, 151, 0.08);
  border: 1.5rpx solid rgba(111, 207, 151, 0.3);
  border-radius: 24rpx;
  padding: 22rpx 32rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  line-height: 1.6;
  box-sizing: border-box;
}

/* ── 文字发送按钮 ── */
.hint-send-btn {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  background: var(--color-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.hint-send-btn.hint-send-disabled {
  opacity: 0.35;
}

.hint-send-icon {
  width: 32rpx;
  height: 32rpx;
}

.hint-placeholder {
  color: var(--color-text-tertiary);
  font-size: var(--font-size-sm);
}

.footer-hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  letter-spacing: 1rpx;
}

/* ══════════════════════════════════════
   LOADING 状态
══════════════════════════════════════ */

.loading-page {
  width: 100%;
  min-height: 100vh;
  background: #F8FCF9;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 48rpx 28rpx;
  box-sizing: border-box;
  gap: 16rpx;
}

/* 扫描框气泡 */
.lp-scan {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.lp-scan-frame {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  background: rgba(111, 207, 151, 0.1);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lp-scan-corner {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-style: solid;
  border-color: var(--color-primary);
}

.lp-scan-tl { top: 6rpx; left: 6rpx; border-width: 3rpx 0 0 3rpx; border-top-left-radius: 4rpx; }
.lp-scan-tr { top: 6rpx; right: 6rpx; border-width: 3rpx 3rpx 0 0; border-top-right-radius: 4rpx; }
.lp-scan-bl { bottom: 6rpx; left: 6rpx; border-width: 0 0 3rpx 3rpx; border-bottom-left-radius: 4rpx; }
.lp-scan-br { bottom: 6rpx; right: 6rpx; border-width: 0 3rpx 3rpx 0; border-bottom-right-radius: 4rpx; }

.lp-scan-heart {
  font-size: 32rpx;
  animation: lp-pulse 1.6s ease-in-out infinite;
}

@keyframes lp-pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50%       { transform: scale(0.82); opacity: 0.65; }
}

.lp-scan-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary);
  letter-spacing: 2rpx;
}

/* 主插画：520×540 盒子 + aspectFit，竖图可充分展开 */
.lp-hero {
  width: 520rpx;
  height: 540rpx;
}

/* 主标题 */
.lp-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-primary);
  text-align: center;
  letter-spacing: 1rpx;
  margin-bottom: -8rpx;
}

/* 副标题 */
.lp-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.5;
}

/* 进度条卡片 */
.lp-progress-card {
  width: 100%;
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  padding: 14rpx var(--spacing-lg);
  box-sizing: border-box;
}

.lp-progress-track {
  width: 100%;
  height: 10rpx;
  background: rgba(111, 207, 151, 0.2);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.lp-progress-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: var(--radius-full);
  transition: width 0.6s ease;
}

/* 底部提示胶囊 */
.lp-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  border: 1.5rpx solid rgba(111, 207, 151, 0.5);
  border-radius: var(--radius-full);
  padding: 10rpx 32rpx;
  background: rgba(111, 207, 151, 0.04);
}

.lp-tip-leaf {
  font-size: 22rpx;
  line-height: 1;
}

.lp-tip-text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  letter-spacing: 0.5rpx;
}

/* ══════════════════════════════════════
   RESULT 状态
══════════════════════════════════════ */

.result-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: var(--spacing-xl) var(--page-padding) 0;
  padding-bottom: calc(320rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(320rpx + env(safe-area-inset-bottom));
}

.result-header {
  padding-top: var(--spacing-xl);
  margin-bottom: var(--spacing-lg);
}

.result-title {
  display: block;
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--color-text-primary);
}

.result-card-wrap {
  margin-bottom: var(--spacing-lg);
}

/* ── 份量快捷调整 ── */
.ratio-section {
  margin-bottom: var(--spacing-lg);
}

.ratio-title {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-sm);
}

.ratio-buttons {
  display: flex;
  gap: var(--spacing-sm);
}

.ratio-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: var(--radius-full);
  text-align: center;
}

.ratio-btn::after {
  border: none;
}

.ratio-btn.active {
  color: var(--color-primary);
  background: rgba(111, 207, 151, 0.12);
  border-color: var(--color-primary);
  font-weight: 600;
}

/* 底部操作区（固定 + 安全区） */
/* ── 共享这一餐 ── */
.share-section {
  margin-bottom: var(--spacing-lg);
}

.share-title {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-sm);
}

.share-mode-row {
  display: flex;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}

.share-chip {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: var(--radius-full);
}

.share-chip.active {
  color: var(--color-primary);
  background: rgba(111, 207, 151, 0.12);
  border-color: var(--color-primary);
  font-weight: 600;
}

.split-section {
  padding: var(--spacing-md);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.split-title {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-sm);
}

.split-row {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-md);
}

.split-chip {
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: var(--radius-full);
}

.split-chip.active {
  color: var(--color-primary);
  background: rgba(111, 207, 151, 0.12);
  border-color: var(--color-primary);
  font-weight: 600;
}

.share-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-md);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--color-border);
}

.share-preview-me {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-me);
}

.share-preview-sep {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.share-preview-ta {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-carbs);
}

/* ── 底部操作区（固定 + 安全区） */
.result-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--spacing-md) var(--page-padding);
  padding-bottom: calc(var(--spacing-md) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  background: var(--color-bg);
  border-top: 1rpx solid var(--color-border);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

/* 继承全局 .primary-btn，补充 button 元素所需的宽度与边框重置 */
.result-save-btn {
  width: 100%;
}

.result-save-btn::after {
  border: none;
}

.btn-ghost {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: transparent;
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  border: none;
  border-radius: var(--radius-full);
}

.btn-ghost::after {
  border: none;
}

/* ══════════════════════════════════════
   手动记录区域
══════════════════════════════════════ */

.manual-section {
  width: 100%;
  max-width: 560rpx;
}

.manual-toggle {
  display: block;
  text-align: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  padding: var(--spacing-xs) 0;
}

.manual-form {
  margin-top: var(--spacing-md);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-card);
}

.manual-row {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.manual-row:last-of-type {
  border-bottom: none;
}

.manual-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  width: 160rpx;
  flex-shrink: 0;
}

.manual-required {
  color: var(--color-warning, #EB5757);
}

.manual-input {
  flex: 1;
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  text-align: right;
}

.manual-save-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin-top: var(--spacing-lg);
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-size-sm);
  font-weight: 600;
  border-radius: var(--radius-full);
  border: none;
  line-height: normal;
}

.manual-save-btn::after {
  border: none;
}

