<!-- pages/record/record.wxml -->
<view class="page">

  <!-- ══════════════ IDLE 状态 ══════════════ -->
  <view wx:if="{{state === 'idle'}}" class="idle-page">
    <view class="idle-header">
      <text class="page-title">拍一餐</text>
      <text class="page-subtitle">饭前拍一下，轻轻记录这一餐</text>
    </view>

    <view class="idle-camera">
      <view class="hint-input-wrap">
        <textarea
          class="hint-input"
          value="{{aiHint}}"
          placeholder="可以补充：这是什么 / 吃了多少"
          placeholder-class="hint-placeholder"
          maxlength="80"
          auto-height
          show-confirm-bar="{{false}}"
          bind:input="onHintInput"
        />
      </view>
      <camera-button bind:tap="onCameraTap" />
    </view>

    <view class="idle-footer">
      <text class="footer-hint">今天还没有记录</text>
    </view>
  </view>

  <!-- ══════════════ LOADING 状态 ══════════════ -->
  <view wx:elif="{{state === 'loading'}}" class="loading-page">
    <image class="loading-bg" src="{{tempImageUrl}}" mode="aspectFill" />
    <view class="loading-mask">
      <view class="loading-content">
        <view class="loading-dots">
          <view class="dot dot-1"></view>
          <view class="dot dot-2"></view>
          <view class="dot dot-3"></view>
        </view>
        <text class="loading-text">{{loadingText}}</text>
        <text class="loading-subtext">{{loadingSubtext}}</text>
      </view>
    </view>
  </view>

  <!-- ══════════════ RESULT 状态 ══════════════ -->
  <view wx:elif="{{state === 'result'}}" class="result-page">
    <view class="result-header">
      <text class="result-title">识别完成</text>
    </view>

    <view class="result-card-wrap">
      <food-card
        name="{{foodData.name}}"
        calories="{{foodData.calories}}"
        protein="{{foodData.protein}}"
        fat="{{foodData.fat}}"
        carbs="{{foodData.carbs}}"
        imageUrl="{{foodData.imageUrl}}"
      />
    </view>

    <!-- 份量快捷调整 -->
    <view class="ratio-section">
      <text class="ratio-title">吃了多少？</text>
      <view class="ratio-buttons">
        <button class="ratio-btn {{portionRatio === 1      ? 'active' : ''}}" data-ratio="1"      bind:tap="onRatioTap">全部</button>
        <button class="ratio-btn {{portionRatio === 0.5    ? 'active' : ''}}" data-ratio="0.5"    bind:tap="onRatioTap">1/2</button>
        <button class="ratio-btn {{portionRatio === 0.6667 ? 'active' : ''}}" data-ratio="0.6667" bind:tap="onRatioTap">2/3</button>
        <button class="ratio-btn {{portionRatio === 0.3333 ? 'active' : ''}}" data-ratio="0.3333" bind:tap="onRatioTap">1/3</button>
      </view>
    </view>

    <view class="result-actions">
      <button class="primary-btn result-save-btn" bind:tap="onSave">记录这一餐</button>
      <button class="btn-ghost" bind:tap="onRetake">重新拍摄</button>
    </view>
  </view>

</view>
