/* components/summary-card/summary-card.wxss */

.summary-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-card);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
}

.user-name {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.calorie-ring {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-full);
  border: 5rpx solid var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ring-pct {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.cal-block {
  display: flex;
  align-items: baseline;
  margin-bottom: 4rpx;
}

.cal-current {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1;
}

.cal-unit {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.cal-goal {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-lg);
}

/* ── 我（蓝色） ── */
.summary-card.me .cal-current  { color: var(--color-me); }
.summary-card.me .calorie-ring { border-color: var(--color-me-light); }
.summary-card.me .ring-pct     { color: var(--color-me); }

/* ── Ta（玫瑰） ── */
.summary-card.ta .cal-current  { color: var(--color-ta); }
.summary-card.ta .calorie-ring { border-color: var(--color-ta-light); }
.summary-card.ta .ring-pct     { color: var(--color-ta); }

/* ── 超标警告 ── */
.summary-card.over .cal-current  { color: var(--color-warning); }
.summary-card.over .calorie-ring { border-color: var(--color-warning-light); }
.summary-card.over .ring-pct     { color: var(--color-warning); }
