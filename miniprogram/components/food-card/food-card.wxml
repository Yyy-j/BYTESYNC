<!-- components/food-card/food-card.wxml -->
<view class="food-card">
  <image wx:if="{{imageUrl}}" class="food-image" src="{{imageUrl}}" mode="aspectFill" />
  <view class="food-info">
    <text class="food-name">{{name}}</text>
    <view class="calories-row">
      <text class="kcal-number">{{calories}}</text>
      <text class="kcal-unit">kcal</text>
    </view>
    <view class="food-macros">
      <view class="macro-item">
        <text class="macro-value protein">{{protein}}g</text>
        <text class="macro-label">蛋白质</text>
      </view>
      <view class="macro-divider"></view>
      <view class="macro-item">
        <text class="macro-value carbs">{{carbs}}g</text>
        <text class="macro-label">碳水</text>
      </view>
      <view class="macro-divider"></view>
      <view class="macro-item">
        <text class="macro-value fat">{{fat}}g</text>
        <text class="macro-label">脂肪</text>
      </view>
    </view>
  </view>
</view>
