<!-- components/food-card/food-card.wxml -->
<view class="food-card">
  <image class="food-image" src="{{imageUrl}}" mode="aspectFill" />
  <view class="food-info">
    <text class="food-name">{{name}}</text>
    <text class="food-calories">{{calories}} kcal</text>
    <view class="food-macros">
      <text class="macro-tag protein">蛋白 {{protein}}g</text>
      <text class="macro-tag carbs">碳水 {{carbs}}g</text>
      <text class="macro-tag fat">脂肪 {{fat}}g</text>
    </view>
  </view>
</view>
