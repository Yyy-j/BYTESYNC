/* components/food-card/food-card.wxss */

.food-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.food-image {
  width: 100%;
  height: 380rpx;
  display: block;
  background: var(--color-border);
}

.food-info {
  padding: var(--spacing-lg);
}

.food-name {
  display: block;
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.calories-row {
  display: flex;
  align-items: baseline;
  gap: var(--spacing-xs);
  margin-top: var(--spacing-sm);
}

.kcal-number {
  font-size: var(--font-size-num);
  font-weight: 700;
  color: var(--color-primary-dark);
  line-height: 1;
}

.kcal-unit {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  font-weight: 500;
}

.food-macros {
  display: flex;
  align-items: center;
  margin-top: var(--spacing-lg);
  padding-top: var(--spacing-md);
  border-top: 1rpx solid var(--color-border);
}

.macro-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.macro-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--color-border);
}

.macro-value {
  display: block;
  font-size: var(--font-size-md);
  font-weight: 600;
  line-height: 1;
}

.macro-value.protein { color: var(--color-protein); }
.macro-value.carbs   { color: var(--color-carbs);   }
.macro-value.fat     { color: var(--color-fat);     }

.macro-label {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}
