/* components/food-list-item/food-list-item.wxss */

.food-list-item {
  padding: var(--spacing-lg) var(--page-padding);
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border);
}

.food-list-item:last-child {
  border-bottom: none;
}

/* ── 第一行：食物名 + 时间 ── */
.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.item-name {
  font-size: var(--font-size-md);
  font-weight: 500;
  color: var(--color-text-primary);
  flex: 1;
}

.item-time {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
}

/* ── 第二行：热量 + 用户强调 ── */
.item-row2 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-xs);
}

.item-calories {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  font-weight: 600;
}

.user-badge {
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
}

.user-badge.me { background: var(--color-me-light); }
.user-badge.ta { background: var(--color-ta-light); }

.user-badge-text {
  font-size: var(--font-size-xs);
  font-weight: 600;
}

.user-badge.me .user-badge-text { color: var(--color-me); }
.user-badge.ta .user-badge-text { color: var(--color-ta); }

/* ── 第三行：宏量标签 ── */
.item-macros {
  display: flex;
  gap: var(--spacing-xs);
}

.macro-tag {
  font-size: var(--font-size-xs);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
}

.macro-tag.protein { background: var(--color-protein-bg); color: var(--color-protein); }
.macro-tag.carbs   { background: var(--color-carbs-bg);   color: var(--color-carbs);   }
.macro-tag.fat     { background: var(--color-fat-bg);     color: var(--color-fat);     }
