<!-- components/food-list-item/food-list-item.wxml -->
<view class="food-list-item" bind:tap="onTap">
  <view class="item-header">
    <text class="item-name">{{name}}</text>
    <text class="item-time">{{time}}</text>
  </view>
  <view class="item-row2">
    <text class="item-calories">{{calories}} kcal</text>
    <view wx:if="{{user}}" class="user-badge {{user}}">
      <text class="user-badge-text">{{userName}}</text>
    </view>
  </view>
  <view class="item-footer">
    <view class="item-macros">
      <text class="macro-tag protein">蛋白 {{protein}}g</text>
      <text class="macro-tag carbs">碳水 {{carbs}}g</text>
      <text class="macro-tag fat">脂肪 {{fat}}g</text>
    </view>
    <text wx:if="{{canDelete}}" class="delete-btn" catchtap="onDeleteTap">删除</text>
  </view>
</view>
