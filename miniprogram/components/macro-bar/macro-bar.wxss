/* components/macro-bar/macro-bar.wxss */

.macro-bar {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.macro-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.macro-label {
  width: 100rpx;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

.macro-track {
  flex: 1;
  height: 6rpx;
  background: var(--color-border);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.macro-fill {
  height: 100%;
  border-radius: var(--radius-full);
  transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.macro-fill.protein { background: var(--color-protein); }
.macro-fill.carbs   { background: var(--color-carbs);   }
.macro-fill.fat     { background: var(--color-fat);     }

.macro-value {
  width: 72rpx;
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  text-align: right;
  flex-shrink: 0;
}
